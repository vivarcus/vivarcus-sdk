# 复制为 deploy.env（与任意示例同级目录 examples/deploy.env，勿提交 git）。
# deploy.sh 只使用 session token + 地址 + Vault ID，不读取账号密码。
#
# 若已在本机执行过 vivarcus auth login，通常不必建 deploy.env。

# Vault 根 URL（必填，无末尾斜杠）
VIVARCUS_ENDPOINT=https://your-tenant.vivarcus.com

# 目标 Vault 数字 ID（必填）
VIVARCUS_VAULT=123456

# 登录后的 session token（必填；从 auth login、浏览器或 CI secret 取得，不是密码）
VIVARCUS_TOKEN=

# 可选：vivarcus 二进制路径
# VIVARCUS_BIN=vivarcus
