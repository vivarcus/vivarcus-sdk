RECREATE Objectlifecycle sdk_demo_lc__c (
  label('SDK Demo LC'),
  active(true),
  starting_state('Objectlifecyclestate.draft__c'),
  Objectlifecyclestate draft__c(
    label('Draft'),
    active(true),
    record_status('active__v')
  ),
  Objectlifecyclestate in_review__c(
    label('In Review'),
    active(true),
    record_status('active__v')
  ),
  Objectlifecyclestateuseraction draft__c.start_capture_wf__c(
    label('Start Capture Participants WF'),
    rule({<?xml version="1.0" encoding="UTF-8"?>
<rule><actions><action type="LIFECYCLE_RUN_WORKFLOW_ACTION" objectWorkflow="Objectworkflow.capture_participants_wf__c"/></actions></rule>}),
    order(1000)
  )
);
