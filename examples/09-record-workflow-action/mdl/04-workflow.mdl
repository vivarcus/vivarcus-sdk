RECREATE Objectworkflow capture_participants_wf__c (
  label('Capture Participants WF'),
  active(true),
  object_lifecycles('Objectlifecycle.sdk_demo_lc__c'),
  auto_start(false),
  cardinality('One'),
  workflow_content_type('Object'),
  cancellation_comment(false),
  Objectworkflowstep start__c(
    label('Start'),
    type('start'),
    next_steps('end__c'),
    step_detail({<?xml version="1.0" encoding="UTF-8"?>
<vwf:stepdetails xmlns:vwf="VeevaVault">
  <vwf:dialog type="wad">
    <vwf:controls>
      <vwf:control name="approver__c" label="Approver" type="participant">
        <vwf:recordWorkflowActions>
          <vwf:recordWorkflowAction reference="Recordworkflowaction.acme.corp.sdkdemo.CaptureParticipants" />
        </vwf:recordWorkflowActions>
      </vwf:control>
    </vwf:controls>
  </vwf:dialog>
</vwf:stepdetails>})
  ),
  Objectworkflowstep end__c(
    label('End'),
    type('end'),
    step_detail({<?xml version="1.0"?><vwf:stepdetails xmlns:vwf="VeevaVault"><vwf:endType type="end"/></vwf:stepdetails>})
  )
);
