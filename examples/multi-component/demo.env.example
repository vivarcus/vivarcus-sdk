# Copy to demo.env to override defaults (local only; not committed).

DEMO_MDL_DIR=mdl

OBJECT=sdk_demo__c
OBJECT_LABEL='SDK Demo'
OBJECT_LABEL_PLURAL='SDK Demos'

SET_TITLE_ACTION=set_title__c
CLEAR_TITLE_ACTION=clear_title__c
SET_TITLE_EXPECTED=from-sdk
# CLEAR_TITLE_EXPECTED=
EXPECT_NAME_SUFFIX=-trig

LIFECYCLE=sdk_demo_lc__c
SUBMIT_ACTION=submit__c
ENTRY_TITLE_EXPECTED=stamped-on-enter
STAMP_ON_ENTER_MATCH=StampOnEnter

TITLE_FIELD=title__c
