  label_plural('SDK Demos'),
  active(true),
  in_menu(true),
  audit(false),
  Field name__v (
    type('String'),
    label('Name'),
    required(false),
    list_column(true),
    active(true)
  ),
  Field title__c (
    type('String'),
    label('Title'),
    required(false),
    list_column(true),
    active(true)
  )
);
